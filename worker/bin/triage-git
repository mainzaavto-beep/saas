#!/bin/bash
# triage-git — только чтение истории репозитория для авторазбора: log/show/diff,
# без --output, внешних diff, textconv, --no-index и путей вне рабочего дерева.
# `git diff --no-index <file> <file>` (и даже без флага — git сам переключается в
# no-index-режим на путях вне репозитория) печатает содержимое ЛЮБОГО файла под правами
# процесса — поэтому абсолютные пути, `..` и `--no-index` запрещены целиком (найдено
# ревью 01.10.2026, см. §11 спеки). Диапазоны вида a..b не поддерживаются (запрет '..' ниже) —
# используй `log b ^a`. db/migrations/001_tenant_core.sql несёт захардкоженный пароль БД
# (заплатка до отдельной чистки) — любой аргумент с этой подстрокой отклоняется, чтобы
# show/diff не могли напечатать файл по пути (ревью task-9, 01.10.2026). Запрет по имени файла
# не ловит `show <ревизия>`/`log -p`, когда путь не назван в аргументах явно (напр. `show
# f288080`), поэтому ниже дополнительно вычёркиваем сам пароль из вывода по значению, а не по
# имени (ревью, раунд 2, 01.10.2026).
# Использование: triage-git log|show|diff [args...]
set -euo pipefail
sub="${1:-}"; shift || true
case "$sub" in log|show|diff) ;; *) echo "triage-git: разрешены log, show, diff" >&2; exit 2;; esac
for a in "$@"; do
  case "$a" in
    *001_tenant_core*) echo "triage-git: запрещённый путь: $a" >&2; exit 2;;
    --) echo "triage-git: '--' запрещён: $a" >&2; exit 2;;
    --no-index|--no-index=*)
      echo "triage-git: --no-index запрещён (читает любой файл вне репозитория): $a" >&2; exit 2;;
    /*) echo "triage-git: абсолютные пути запрещены: $a" >&2; exit 2;;
    --output*|-[oO]*|--order-file*|--ext-diff*|--textconv*|-c|--exec*|--upload-pack*|--git-dir*|--work-tree*)
      echo "triage-git: аргумент запрещён: $a" >&2; exit 2;;
  esac
  case "$a" in *..*) echo "triage-git: '..' запрещён: $a" >&2; exit 2;; esac
  [[ "$a" =~ ^[A-Za-z0-9._/@^~:=+,-]+$ ]] || { echo "triage-git: недопустимые символы: $a" >&2; exit 2; }
done
cd /opt/agents/saas

# Значение пароля saas_app читаем из /etc/saas-worker.env в подоболочке (не экспортируем в
# окружение этого процесса, не печатаем) — только чтобы вычеркнуть его из вывода git построчно.
pass=""
if [ -r /etc/saas-worker.env ]; then
  pass="$( . /etc/saas-worker.env >/dev/null 2>&1; printf '%s' "${SAAS_APP_DB_PASSWORD:-}" )" || true
fi

set +e
if [ -n "$pass" ]; then
  git --no-pager -c core.pager=cat -c diff.external= "$sub" --no-ext-diff --no-textconv "$@" | grep -vF -e "$pass"
  rc=${PIPESTATUS[0]}
else
  git --no-pager -c core.pager=cat -c diff.external= "$sub" --no-ext-diff --no-textconv "$@"
  rc=$?
fi
set -e
exit "$rc"
