[Unit]
Description=SAAS Stocks — снимок остатков 1×/день (08:00)

[Timer]
# Остатки собираются раз в сутки — снимок «на сейчас» (WB не отдаёт историю).
# 08:00 (с 05:00, gotcha #141): рано утром WB API часто уходит в жёсткий 429 и
# отдаёт неполные склады (остатки ещё не разъехались). К 08:00 лимит/данные
# стабилизируются — снимок полнее.
OnCalendar=*-*-* 08:00:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
