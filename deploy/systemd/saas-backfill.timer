[Unit]
Description=SAAS Backfill — прогон очереди onboarding-jobs каждые 5 минут

[Timer]
# Раз в 5 минут: клиент, только что подключивший ключи, должен увидеть данные за
# минуты, а не ждать до 3,5 часов следующего слота. Холостой прогон при пустой
# очереди — один запрос к БД и выход, сетевых обращений нет.
# Сетка :02, :07, :12, :17, :22, :27, :32, :37, :42, :47, :52, :57 намеренно смещена
# от saas-worker.timer (05:15, 09:00, 12:00, 17:00), чтобы не бить API маркетплейсов
# одновременно. Systemd не запустит второй экземпляр сервиса, пока работает первый,
# поэтому наложения одного backfill на другой исключены.
OnCalendar=*:2/5
# Если сервер был выключен — догнать при старте
Persistent=true
# Разброс ±30 сек — достаточно, чтобы не совпадать в одной микросекунде, и сохраняет
# бюджет ожидания для клиента. Худший случай: сетка (до 2.5 мин до отметки) + разброс (до 0.5 мин) + AccuracySec (до 1 мин) ≈ 4.5 мин.
RandomizedDelaySec=30s
AccuracySec=1min

[Install]
WantedBy=timers.target
