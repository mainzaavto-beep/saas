[Unit]
Description=SAAS Backfill — прогон очереди onboarding-jobs каждые 5 минут

[Timer]
# Раз в 5 минут: клиент, только что подключивший ключи, должен увидеть данные за
# минуты, а не ждать до 3,5 часов следующего слота. Холостой прогон при пустой
# очереди — один запрос к БД и выход, сетевых обращений нет.
# Сетка :02, :07, :12, :17, :22, :27, :32, :37, :42, :47, :52, :57 смещена
# от saas-worker.timer (05:15, 09:00, 12:00, 17:00) для разведения отметок в конфиге;
# фактические запуски могут пересекаться редко из-за собственного разброса worker (±3 мин).
# Systemd не запустит второй экземпляр backfill, пока работает первый.
# Худший случай: сетка до 5 мин (после срабатывания отметки) + разброс до 15 с +
# точность ~1 с ≈ 5,3 мин до старта службы; плюс сбор ≈1,5 мин ≈ 6,8 мин до данных —
# укладывается в обещание спеки «первые цифры через 5–10 минут».
OnCalendar=*:2/5
# Если сервер был выключен — догнать при старте
Persistent=true
# Разброс ±15 сек — разведение с worker обеспечено сеткой, разброс вспомогательный
RandomizedDelaySec=15s
# AccuracySec=1s убирает коалессинг-люфт (для одного таймера раз в 5 мин — непроблемно)
AccuracySec=1s

[Install]
WantedBy=timers.target
