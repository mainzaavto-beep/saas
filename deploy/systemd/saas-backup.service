[Unit]
Description=SAAS backup (daily pg_dump + offsite restic → Yandex Object Storage)
After=network.target postgresql.service
Requires=postgresql.service
OnFailure=saas-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
# Креды: .env.local (хост/порт/имя базы) + /etc/saas-worker.env (POSTGRES_PASSWORD для полного дампа)
EnvironmentFile=/opt/agents/saas/.env.local
EnvironmentFile=/etc/saas-worker.env
# Креды Yandex Object Storage + пароль restic (root, 600, вне git)
EnvironmentFile=/etc/saas-backup.env
ExecStart=/opt/agentsDB/backup_saas.sh
# Шаг 2: копия вне сервера (дамп + код + секреты). Падение → OnFailure, как и у дампа.
ExecStart=/opt/agents/saas/deploy/backup/offsite_backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=saas-backup
# Дамп ~1 мин + отправка ~1 мин (+ воскресный check); 30 минут с запасом
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
