[Unit]
Description=SAAS Cabinet — тики кабинета Ozon 06:00 и 20:00 MSK (мимо утреннего синка ozon-panel)

[Timer]
OnCalendar=*-*-* 06,20:00:00
# Ревью задачи 6, находка №4: догон пропущенного тика намеренно не включён.
# Пропуск безвреден — окно сбора 3 дня, следующий тик доберёт; а с догоном
# после простоя сервера пропущенный запуск мог попасть прямо на утренний синк
# ozon-panel — тот же профиль Chromium, конфликт по flock/SingletonLock (§4.3).
AccuracySec=1min

[Install]
WantedBy=timers.target
