[Unit]
Description=SAAS SKU-Ad Night — ночной сбор рекламы Ozon по товарам (03:30)

[Timer]
# 03:30 MSK — вне дневного окна очереди Performance API (SKIP_WINDOW_MSK =
# 4..16 MSK в worker/collectors/ozon_sku_ad.py). До первого утреннего тика
# saas-worker (05:15), так что реклама за вчера уже лежит в БД к утру.
OnCalendar=*-*-* 03:30:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
